# Murmeli configuration. Copy to .env and fill in the required values.
# The full reference is in docs/site/reference/configuration.md.

# Image tag to run (latest, or a release such as 0.3.0)
MURMELI_VERSION=latest
FRONTEND_PORT=8080

# Public URL (used in email links) and allowed browser origins
APP_URL=https://murmeli.example.com
CORS_ORIGINS=
TRUST_PROXY=1
LOG_LEVEL=info

# Database
POSTGRES_USER=murmeli
POSTGRES_PASSWORD=
POSTGRES_DB=murmeli
DB_MIGRATIONS_RUN=true

# Redis (Valkey)
REDIS_PASSWORD=

# Secrets: generate each one with `openssl rand -base64 48`
JWT_SECRET=
ENCRYPTION_KEY=
ALTCHA_HMAC_KEY=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Cookies
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Email (leave SMTP_HOST empty to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Murmeli <no-reply@example.com>"

# Initial registration setting. After the first start, admins change it in the UI.
REGISTRATION_ENABLED=false

# Backups (pg_dump before every migration)
BACKUP_MANDATORY=true
BACKUP_KEEP_COUNT=10

# Send HSTS from nginx. Enable only when the site is served over HTTPS.
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
# IPs/CIDRs of the TLS reverse proxy in front of the app (e.g. 172.16.0.0/12).
# Only these may set X-Forwarded-For/-Proto. Empty: those headers are ignored.
TRUSTED_PROXIES=
# DNS resolver nginx uses to find the backend (default: from /etc/resolv.conf)
NGINX_RESOLVER=
# Upstream for /api (only change this if the backend runs elsewhere)
# BACKEND_URL=http://backend:3000

# Rate limits (requests per IP and route)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120
RATE_LIMIT_AUTH_TTL_SECONDS=300
RATE_LIMIT_AUTH_LIMIT=10

# docker-compose.yml sets these for the backend container. You only need them
# when running the backend outside Docker (see backend/.env.example):
# NODE_ENV, PORT, DATABASE_HOST, DATABASE_PORT, DATABASE_USERNAME,
# DATABASE_PASSWORD, DATABASE_NAME, REDIS_HOST, REDIS_PORT, BACKUP_DIR
