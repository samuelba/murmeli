{
  "name": "murmeli-frontend",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "npm run brand:check && npm run content:check && ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:sync": "node scripts/sync-brand.mjs",
    "brand:check": "node scripts/sync-brand.mjs --check",
    "content:sync": "node scripts/sync-content.mjs",
    "content:check": "node scripts/sync-content.mjs --check",
    "check:external": "node scripts/check-no-external-urls.mjs dist/murmeli-frontend/browser",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "serve:dist": "node scripts/serve-dist.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/andika": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@murmeli/content": "file:../content",
    "altcha": "^3.7.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "altcha-lib": "^2.10.0",
    "angular-eslint": "22.8.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.0.0"
  }
}
