worker_processes auto;
pid /tmp/nginx/nginx.pid;
error_log stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    client_body_temp_path /tmp/nginx/client_temp;
    proxy_temp_path /tmp/nginx/proxy_temp;
    fastcgi_temp_path /tmp/nginx/fastcgi_temp;
    uwsgi_temp_path /tmp/nginx/uwsgi_temp;
    scgi_temp_path /tmp/nginx/scgi_temp;

    include /tmp/nginx/real-ip.conf;

    geo $realip_remote_addr $from_trusted_proxy {
        default 0;
        include /tmp/nginx/trusted-proxies.conf;
    }

    map "$from_trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
        default $scheme;
        "~^1:(?<proto>https?)$" $proto;
    }

    map $request_uri $request_path {
        "~^(?<path>[^?]*)" $path;
    }

    # Secrets that travel in the path (invite tokens) never reach the access log.
    map $request_path $log_path {
        "~^/api/invites/[^/]+/accept/?$" "/api/invites/:token/accept";
        "~^/api/invites/[^/]+/?$"        "/api/invites/:token";
        "~^/invite/[^/]+/?$"             "/invite/:token";
        default                          $request_path;
    }

    log_format murmeli escape=json
        '{"time":"$time_iso8601","client":"$remote_addr","method":"$request_method",'
        '"path":"$log_path","status":$status,"bytes":$body_bytes_sent,'
        '"request_time":$request_time}';
    access_log /dev/stdout murmeli;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    server {
        listen 8080;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;
        absolute_redirect off;

        include /tmp/nginx/security-headers.conf;

        location = /healthz {
            access_log off;
            default_type text/plain;
            charset utf-8;
            include /tmp/nginx/security-headers.conf;
            add_header Cache-Control "no-store" always;
            return 200 "ok\n";
        }

        location ~* "^/api/health/ready(?:/|$)" {
            return 404;
        }

        location /api/ {
            include /tmp/nginx/security-headers.conf;
            add_header Cache-Control "no-store" always;

            set $backend "${BACKEND_URL}";
            proxy_pass $backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Connection "";
            proxy_ssl_server_name on;
            proxy_hide_header X-Powered-By;
            proxy_hide_header Cache-Control;
            proxy_hide_header Content-Security-Policy;
            proxy_hide_header X-Content-Type-Options;
            proxy_hide_header X-Frame-Options;
            proxy_hide_header Referrer-Policy;
            proxy_hide_header Permissions-Policy;
            proxy_hide_header Cross-Origin-Opener-Policy;
            proxy_hide_header Cross-Origin-Resource-Policy;
            proxy_hide_header Strict-Transport-Security;
        }

        # Emails load the logo from other origins, so brand assets allow cross-origin embedding.
        location ^~ /brand/ {
            include /tmp/nginx/security-headers-cross-origin.conf;
            add_header Cache-Control "public, max-age=86400" always;
            try_files $uri =404;
        }

        # Narration (content/audio): the manifest is revalidated; clips are fetched with
        # ?v=<manifest version>, so they can be cached for a year.
        location ^~ /audio/ {
            include /tmp/nginx/security-headers.conf;
            add_header Cache-Control "no-cache" always;
            types {
                application/json json;
                audio/ogg opus ogg;
            }
            location ~ "^/audio/[A-Za-z-]+/[A-Za-z0-9_-]+\.(?:opus|ogg)$" {
                include /tmp/nginx/security-headers.conf;
                add_header Cache-Control "public, max-age=31536000, immutable" always;
                types {
                    audio/ogg opus ogg;
                }
                try_files $uri =404;
            }
            try_files $uri =404;
        }

        location ^~ /pictures/ {
            include /tmp/nginx/security-headers.conf;
            types {
                image/svg+xml svg;
                text/markdown md;
            }
            default_type text/plain;
            charset utf-8;
            # A second, stricter CSP for SVGs opened directly (browsers enforce both).
            add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox" always;
            add_header Cache-Control "public, max-age=86400" always;
            try_files $uri =404;
        }

        # Angular service worker: the script and its manifest must always be revalidated, so
        # an update reaches every device. Missing files are a 404, never index.html.
        location ~ "^/(?:ngsw-worker\.js|ngsw\.json|safety-worker\.js|worker-basic\.min\.js)$" {
            include /tmp/nginx/security-headers.conf;
            add_header Cache-Control "no-cache" always;
            try_files $uri =404;
        }

        location = /manifest.webmanifest {
            include /tmp/nginx/security-headers.conf;
            add_header Cache-Control "no-cache" always;
            types { }
            default_type application/manifest+json;
            try_files $uri =404;
        }

        location ~ "^/(?:media/)?[^/]+-[A-Za-z0-9]{8}\.(?:js|css|woff2?)$" {
            include /tmp/nginx/security-headers.conf;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files $uri =404;
        }

        location / {
            include /tmp/nginx/security-headers.conf;
            add_header Cache-Control "no-cache" always;
            try_files $uri $uri/ /index.html;
        }
    }
}
