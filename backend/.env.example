# Local development values for the backend. They are rejected with
# NODE_ENV=production; see src/config/README.md for every variable.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_URL=http://localhost:4200
CORS_ORIGINS=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=murmeli
DATABASE_PASSWORD=dev-only-db-password
DATABASE_NAME=murmeli
DATABASE_SSL=false
DB_MIGRATIONS_RUN=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev-only-redis-password

JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
ENCRYPTION_KEY=dev-only-encryption-key-change-me-0123456789
ALTCHA_HMAC_KEY=dev-only-altcha-key-change-me-0123456789abcd

COOKIE_SECURE=false

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Murmeli <no-reply@localhost>

REGISTRATION_ENABLED=true

# Set to true to open every level for testing
LEARNING_UNLOCK_ALL=false

BACKUP_DIR=./backups
