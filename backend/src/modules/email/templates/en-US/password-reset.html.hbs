{{#> layout}}
<h1 style="margin:0 0 16px 0;font-size:24px;line-height:1.3;color:#1E2A3E;">Choose a new password</h1>
<p style="margin:0 0 16px 0;">You asked for a new {{brandName}} password. Use the button below to choose one.</p>
<p style="margin:24px 0;text-align:center;"><a href="{{link}}" style="display:inline-block;padding:14px 28px;background-color:#F7C600;color:#1B1B1B;font-weight:800;text-decoration:none;border-radius:999px;border:2px solid #8F6F00;">Choose a new password</a></p>
<p style="margin:0 0 16px 0;">This link is valid for one hour and works only once. If you did not ask for it, just ignore this email and your password stays the same.</p>
<p style="margin:16px 0 0 0;font-size:13px;color:#566179;word-break:break-all;">Button not working? Copy this link into your browser:<br><a href="{{link}}" style="color:#1F6FB8;">{{link}}</a></p>
{{/layout}}
