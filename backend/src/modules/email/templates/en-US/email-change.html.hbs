{{#> layout}}
<h1 style="margin:0 0 16px 0;font-size:24px;line-height:1.3;color:#1E2A3E;">Confirm your new email address</h1>
<p style="margin:0 0 16px 0;">You would like to use <strong>{{newEmail}}</strong> for your {{brandName}} account. Please confirm with the button below.</p>
<p style="margin:24px 0;text-align:center;"><a href="{{link}}" style="display:inline-block;padding:14px 28px;background-color:#F7C600;color:#1B1B1B;font-weight:800;text-decoration:none;border-radius:999px;border:2px solid #8F6F00;">Confirm new address</a></p>
<p style="margin:0 0 16px 0;">This link is valid for 48 hours. Until you confirm, your current address stays in use.</p>
<p style="margin:16px 0 0 0;font-size:13px;color:#566179;word-break:break-all;">Button not working? Copy this link into your browser:<br><a href="{{link}}" style="color:#1F6FB8;">{{link}}</a></p>
{{/layout}}
