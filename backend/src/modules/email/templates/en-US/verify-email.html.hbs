{{#> layout}}
<h1 style="margin:0 0 16px 0;font-size:24px;line-height:1.3;color:#1E2A3E;">Welcome to {{brandName}}!</h1>
<p style="margin:0 0 16px 0;">We are so glad you are here! Please confirm your email address. Then you can sign in and create profiles for your kids.</p>
<p style="margin:24px 0;text-align:center;"><a href="{{link}}" style="display:inline-block;padding:14px 28px;background-color:#F7C600;color:#1B1B1B;font-weight:800;text-decoration:none;border-radius:999px;border:2px solid #8F6F00;">Confirm email address</a></p>
<p style="margin:0 0 16px 0;">This link is valid for 48 hours. If you did not sign up for {{brandName}}, you can safely ignore this email.</p>
<p style="margin:16px 0 0 0;font-size:13px;color:#566179;word-break:break-all;">Button not working? Copy this link into your browser:<br><a href="{{link}}" style="color:#1F6FB8;">{{link}}</a></p>
{{/layout}}
